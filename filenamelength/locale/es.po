msgid "Cannot rename '{}': directory path length ({}) already exceeds or equals desired path length ({})."
msgstr "No se puede renombrar '{}': la longitud del path del directorio ({}) ya supera o iguala la longitud deseada ({})."

msgid "Error renaming '{}' to '{}': {}"
msgstr "Error al renombrar '{}' a '{}': {}"

msgid "Original path"
msgstr "Path original"

msgid "New path"
msgstr "Nuevo path"

msgid "New filename length"
msgstr "Nueva long. de nombre"

msgid "New path length"
msgstr "Nueva long. de path"

msgid "Renamed files:"
msgstr "Ficheros renombrados:"

msgid "{} files renamed."
msgstr "{} ficheros renombrados."

msgid "No files needed to be renamed."
msgstr "Ningún fichero necesita ser renombrado."

msgid "No rename operations to undo."
msgstr "No hay operaciones de renombre que deshacer."

msgid "Cannot undo: '{}' not found."
msgstr "No se puede deshacer: '{}' no encontrado."

msgid "Cannot undo: '{}' already exists."
msgstr "No se puede deshacer: '{}' ya existe."

msgid "Current path"
msgstr "Path actual"

msgid "Restored path"
msgstr "Path restaurado"

msgid "Error restoring '{}' to '{}': {}"
msgstr "Error al restaurar '{}' a '{}': {}"

msgid "Undone rename operations (session {}):"
msgstr "Operaciones de renombre deshechas (sesión {}):"

